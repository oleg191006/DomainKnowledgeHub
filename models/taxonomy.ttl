dkh:e90 a skos:Concept ;
    skos:broader dkh:e67 ;
    skos:definition "Дії, що вводять предмет у публічне або наукове використання."@uk ;
    skos:inScheme dkh:scheme ;
    skos:narrower dkh:e91,
        dkh:e92,
        dkh:e93 ;
    skos:prefLabel "Повернення в обіг"@uk ;
    skos:scopeNote "Принцип поділу дітей: за конкретним поняттям області"@uk .

dkh:e94 a skos:Concept ;
    skos:definition "Особи, органи та сторони, що ухвалюють рішення щодо спадщини або взаємодіють із нею."@uk ;
    skos:inScheme dkh:scheme ;
    skos:narrower dkh:e103,
        dkh:e106,
        dkh:e95 ;
