dkh:f175 a skos:Concept ;
    skos:broader dkh:e113 ;
    skos:definition "Документи, якими юридично оформлюють перехід предметів та обов'язки щодо них."@uk ;
    skos:inScheme dkh:scheme ;
    skos:narrower dkh:e117,
        dkh:e119,
        dkh:e124,
        dkh:f179 ;
    skos:prefLabel "Правові документи руху та відповідальності"@uk ;
