    skos:prefLabel "Обліковий документ"@uk ;
    skos:scopeNote "Принцип поділу дітей: за функцією документа в управлінні зібранням"@uk .

dkh:e55 a skos:Concept ;
    skos:broader dkh:e38 ;
    skos:definition "Живі агенти ураження та умови, що визначають їхню активність."@uk ;
    skos:inScheme dkh:scheme ;
    skos:narrower dkh:e56,
        dkh:e57,
        dkh:e58,
        dkh:e59 ;
    skos:prefLabel "Біологічний чинник"@uk ;
    skos:scopeNote "Принцип поділу дітей: за конкретним поняттям області"@uk .

dkh:f157 a skos:Concept ;
    skos:broader dkh:e67 ;
    skos:definition "Операції над сукупністю термінів і записів, що впорядковують та перевіряють модель."@uk ;
    skos:inScheme dkh:scheme ;
    skos:narrower dkh:f158,
        dkh:f159,
        dkh:f160,
        dkh:f161 ;
    skos:prefLabel "Опрацювання записів знання"@uk ;
    skos:scopeNote "Принцип поділу дітей: за операцією над множиною термінів або записів"@uk .

dkh:f170 a skos:Concept ;
    skos:broader dkh:e112 ;
    skos:definition "Числові величини, якими вимірюють повноту, перевіреність і узгодженість моделі."@uk ;
    skos:inScheme dkh:scheme ;
    skos:narrower dkh:e150,
        dkh:f171,
        dkh:f172,
