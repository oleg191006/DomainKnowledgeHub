    skos:inScheme dkh:scheme ;
    skos:prefLabel "реставраційне завдання"@uk .

dkh:f181 a skos:Concept ;
    skos:altLabel "журнал ТВР"@uk,
        "журнал клімату"@uk ;
    skos:broader dkh:f177 ;
    skos:definition "Документ регулярних записів про показники повітряного середовища."@uk ;
    skos:inScheme dkh:scheme ;
    skos:prefLabel "журнал температурно-вологісного режиму"@uk .

dkh:f182 a skos:Concept ;
    skos:broader dkh:f177 ;
    skos:definition "Документ регулярних записів про перевірку та налаштування засобів вимірювання."@uk ;
    skos:inScheme dkh:scheme ;
    skos:prefLabel "журнал калібрувань"@uk .

dkh:f183 a skos:Concept ;
    skos:broader dkh:f177 ;
    skos:definition "Документ регулярних записів про проведені навчання персоналу."@uk ;
    skos:inScheme dkh:scheme ;
    skos:prefLabel "журнал навчань"@uk .

dkh:e103 a skos:Concept ;
    skos:broader dkh:e94 ;
    skos:definition "Органи, що ухвалюють рішення щодо предметів зібрання колегіально."@uk ;
    skos:inScheme dkh:scheme ;
    skos:narrower dkh:e104,
        dkh:e105 ;
    skos:prefLabel "Колегіальний орган"@uk ;
    skos:scopeNote "Принцип поділу дітей: за конкретним поняттям області"@uk .

dkh:f151 a skos:Concept ;
    skos:broader dkh:e81 ;
    skos:definition "Операції, що відновлюють зв'язність матеріалу механічною або адгезійною дією."@uk ;
    skos:inScheme dkh:scheme ;
    skos:narrower dkh:e84,
        dkh:e85 ;
    skos:prefLabel "Механічне втручання"@uk ;
    skos:scopeNote "Принцип поділу дітей: за конкретним поняттям області"@uk .

dkh:f154 a skos:Concept ;
    skos:broader dkh:e38 ;
    skos:definition "Родові поняття, що узагальнюють причину руйнування та результат її дії."@uk ;
    skos:inScheme dkh:scheme ;
    skos:narrower dkh:f155,
        dkh:f156 ;
