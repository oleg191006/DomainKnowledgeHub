dkh:f179 a skos:Concept ;
    skos:broader dkh:f175 ;
    skos:definition "Документ, у якому послідовно реєструють складені акти."@uk ;
    skos:inScheme dkh:scheme ;
    skos:prefLabel "книга реєстрації актів"@uk .

dkh:f180 a skos:Concept ;
    skos:broader dkh:f176 ;
