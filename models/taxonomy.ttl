    skos:topConceptOf dkh:scheme .

dkh:f152 a skos:Concept ;
    skos:broader dkh:e81 ;
    skos:definition "Операції, що діють на матеріал зміною хімічного складу або фізичних умов середовища."@uk ;
    skos:inScheme dkh:scheme ;
    skos:narrower dkh:e87,
        dkh:e88,
        dkh:e89 ;
    skos:prefLabel "Хімічне і фізичне втручання"@uk ;
    skos:scopeNote "Принцип поділу дітей: за конкретним поняттям області"@uk .

dkh:f153 a skos:Concept ;
    skos:broader dkh:e81 ;
    skos:definition "Операції, що відновлюють цілісність сприйняття твору."@uk ;
    skos:inScheme dkh:scheme ;
    skos:narrower dkh:e82,
        dkh:e83,
        dkh:e86 ;
    skos:prefLabel "Відновлення зображення"@uk ;
    skos:scopeNote "Принцип поділу дітей: за конкретним поняттям області"@uk .

dkh:e113 a skos:Concept ;
    skos:broader dkh:e112 ;
    skos:definition "Документи, якими закріплюють склад зібрання, права на предмети та перебіг робіт."@uk ;
    skos:inScheme dkh:scheme ;
    skos:narrower dkh:f174,
        dkh:f175,
        dkh:f176,
