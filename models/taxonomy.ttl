dkh:e01 a skos:Concept ;
    skos:definition "Матеріальна або цифрова сутність, що є предметом обліку, зберігання та охорони в установі."@uk ;
    skos:inScheme dkh:scheme ;
    skos:narrower dkh:e02,
        dkh:e09,
        dkh:e23 ;
    skos:prefLabel "Об'єкт спадщини"@uk ;
    skos:scopeNote "Принцип поділу дітей: за юридичним режимом об'єкта"@uk ;
    skos:topConceptOf dkh:scheme .

dkh:e146 a skos:Concept ;
    skos:broader dkh:e112 ;
    skos:definition "Позначення, за якими ресурс розпізнають і визначають умови доступу до нього."@uk ;
    skos:inScheme dkh:scheme ;
    skos:narrower dkh:e147,
        dkh:e148,
        dkh:e149 ;
    skos:prefLabel "Ідентифікація"@uk ;
    skos:scopeNote "Принцип поділу дітей: за конкретним поняттям області"@uk .

dkh:e81 a skos:Concept ;
    skos:broader dkh:e67 ;
    skos:definition "Дії, що безпосередньо змінюють матеріальну структуру твору."@uk ;
    skos:inScheme dkh:scheme ;
    skos:narrower dkh:f151,
        dkh:f152,
        dkh:f153 ;
