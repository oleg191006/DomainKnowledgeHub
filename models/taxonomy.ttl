    skos:inScheme dkh:scheme ;
    skos:prefLabel "науково-допоміжний матеріал"@uk .

dkh:f171 a skos:Concept ;
    skos:broader dkh:f170 ;
    skos:definition "Частка термінів корпусу, що розміщені в листках таксономії."@uk ;
    skos:inScheme dkh:scheme ;
    skos:prefLabel "покриття таксономії"@uk .

dkh:f172 a skos:Concept ;
    skos:broader dkh:f170 ;
    skos:definition "Міра узгодженості двох розмітників із поправкою на випадковий збіг."@uk ;
    skos:inScheme dkh:scheme ;
    skos:prefLabel "коефіцієнт згоди"@uk .

dkh:f173 a skos:Concept ;
